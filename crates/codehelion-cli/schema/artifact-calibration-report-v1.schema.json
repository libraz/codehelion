{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/libraz/codehelion/blob/main/crates/codehelion-cli/schema/artifact-calibration-report-v1.schema.json",
  "title": "codehelion artifact calibration report",
  "description": "Local controlled-refactoring calibration summary. An optional baseline comparison is informational and never declares a threshold failure.",
  "type": "object",
  "required": ["schema_version", "source_run", "statistics", "strata"],
  "properties": {
    "schema_version": { "const": "artifact-calibration-report-v1" },
    "source_run": { "type": "integer" },
    "statistics": { "$ref": "#/$defs/statistics" },
    "strata": {
      "type": "array",
      "items": { "$ref": "#/$defs/stratum" }
    },
    "comparison": { "$ref": "#/$defs/comparison" }
  },
  "$defs": {
    "statistics": {
      "type": "object",
      "required": [
        "samples", "median_absolute_error_bytes", "p90_absolute_error_bytes",
        "relative_error_samples", "median_relative_error", "p90_relative_error"
      ],
      "properties": {
        "samples": { "type": "integer", "minimum": 0 },
        "median_absolute_error_bytes": { "type": ["number", "null"], "minimum": 0 },
        "p90_absolute_error_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "relative_error_samples": { "type": "integer", "minimum": 0 },
        "median_relative_error": { "type": ["number", "null"], "minimum": 0 },
        "p90_relative_error": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "stratum": {
      "type": "object",
      "required": ["dimension", "key", "statistics"],
      "properties": {
        "dimension": {
          "type": "string",
          "enum": ["artifact_format", "artifact_build_variant", "clone_type"]
        },
        "key": { "type": "string" },
        "statistics": { "$ref": "#/$defs/statistics" }
      }
    },
    "delta": {
      "type": "object",
      "required": [
        "samples", "median_absolute_error_bytes", "p90_absolute_error_bytes",
        "relative_error_samples", "median_relative_error", "p90_relative_error"
      ],
      "properties": {
        "samples": { "type": "integer" },
        "median_absolute_error_bytes": { "type": ["number", "null"] },
        "p90_absolute_error_bytes": { "type": ["number", "null"] },
        "relative_error_samples": { "type": "integer" },
        "median_relative_error": { "type": ["number", "null"] },
        "p90_relative_error": { "type": ["number", "null"] }
      }
    },
    "comparison": {
      "type": "object",
      "required": [
        "baseline_path", "baseline_schema_version", "baseline_source_run", "overall", "strata"
      ],
      "properties": {
        "baseline_path": { "type": "string" },
        "baseline_schema_version": { "type": "string" },
        "baseline_source_run": { "type": "integer" },
        "overall": { "$ref": "#/$defs/delta" },
        "strata": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dimension", "key", "baseline", "current"],
            "properties": {
              "dimension": { "type": "string" },
              "key": { "type": "string" },
              "baseline": { "anyOf": [{ "$ref": "#/$defs/statistics" }, { "type": "null" }] },
              "current": { "anyOf": [{ "$ref": "#/$defs/statistics" }, { "type": "null" }] },
              "delta": { "$ref": "#/$defs/delta" }
            }
          }
        }
      }
    }
  }
}

