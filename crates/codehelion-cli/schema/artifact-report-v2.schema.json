{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/libraz/codehelion/blob/main/crates/codehelion-cli/schema/artifact-report-v2.schema.json",
  "title": "codehelion artifact report",
  "description": "Machine-readable analysis of one locally read compiled artifact.",
  "type": "object",
  "required": [
    "schema_version",
    "path",
    "format",
    "fingerprint",
    "architecture",
    "skipped_architectures",
    "sizes",
    "sections",
    "section_details",
    "imports",
    "import_details",
    "relocations",
    "relocation_details",
    "data_segments",
    "data_segment_details"
  ],
  "properties": {
    "schema_version": { "const": "artifact-report-v2" },
    "path": { "type": "string" },
    "format": { "type": "string", "enum": ["wasm", "elf", "macho", "pe-coff", "archive"] },
    "architecture": { "type": ["string", "null"] },
    "skipped_architectures": { "type": "array", "items": { "type": "string" } },
    "fingerprint": { "$ref": "#/$defs/fingerprint" },
    "analysis_id": { "type": ["integer", "null"] },
    "build_variant": { "$ref": "#/$defs/build_variant" },
    "sizes": { "$ref": "#/$defs/sizes" },
    "correlation": { "$ref": "#/$defs/correlation" },
    "containment": { "$ref": "#/$defs/containment" },
    "observed_bytes": {
      "type": "integer", "minimum": 0,
      "description": "Bytes read for this artifact, repeated from sizes.observed_bytes."
    },
    "code_section_bytes": { "type": "integer", "minimum": 0 },
    "data_segment_bytes": { "type": "integer", "minimum": 0 },
    "symbols": {
      "type": "array",
      "items": { "$ref": "#/$defs/symbol" }
    },
    "entry_points": {
      "type": "integer", "minimum": 0,
      "description": "Number of parser-established entry points."
    },
    "calls": {
      "type": "integer", "minimum": 0,
      "description": "Number of recorded call edges, resolved or not."
    },
    "source_mappings": {
      "type": "integer", "minimum": 0,
      "description": "Number of source-map references the artifact declares."
    },
    "source_maps": {
      "type": "array",
      "description": "Outcome of each declared reference; nothing is fetched and no source text is retained.",
      "items": { "$ref": "#/$defs/source_map" }
    },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "dead_code": { "$ref": "#/$defs/dead_code" },
    "retained_sizes": {
      "type": ["array", "null"],
      "description": "Overlapping dominator regions, or null when the call graph is incomplete or ambiguous. The entries must never be added together as a total.",
      "items": { "$ref": "#/$defs/retained_size" }
    },
    "duplicates": { "$ref": "#/$defs/duplicate_summary" },
    "duplicate_groups": { "$ref": "#/$defs/duplicate_groups" },
    "sections": { "type": "integer", "minimum": 0 },
    "section_details": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    },
    "imports": { "type": "integer", "minimum": 0 },
    "import_details": {
      "type": "array",
      "items": { "$ref": "#/$defs/import" }
    },
    "relocations": { "type": "integer", "minimum": 0 },
    "relocation_details": {
      "type": "array",
      "items": { "$ref": "#/$defs/relocation" }
    },
    "data_segments": { "type": "integer", "minimum": 0 },
    "data_segment_details": {
      "type": "array",
      "items": { "$ref": "#/$defs/data_segment" }
    },
    "archive_members": {
      "type": "array",
      "items": { "$ref": "#/$defs/archive_member" }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "fingerprint_bytes": {
      "type": "array",
      "description": "The same content identity written as its raw bytes, which is how the metric records nested inside this report spell it.",
      "minItems": 16,
      "maxItems": 16,
      "items": { "type": "integer", "minimum": 0, "maximum": 255 }
    },
    "build_variant": {
      "type": ["object", "null"],
      "required": ["manifest_path", "fingerprint"],
      "properties": {
        "manifest_path": { "type": "string" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "section": {
      "type": "object",
      "required": ["name", "offset", "size", "executable"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "offset": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 0 },
        "executable": { "type": "boolean" }
      }
    },
    "import": {
      "type": "object",
      "required": ["module", "name", "kind"],
      "properties": {
        "module": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "kind": {
          "type": "string",
          "enum": ["function", "table", "memory", "global", "tag", "other"]
        }
      }
    },
    "relocation": {
      "type": "object",
      "required": ["section", "offset", "kind", "target"],
      "properties": {
        "section": { "type": ["integer", "null"], "minimum": 0 },
        "offset": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string" },
        "target": { "type": ["string", "null"] }
      }
    },
    "data_segment": {
      "type": "object",
      "required": ["fingerprint", "section", "offset", "size"],
      "properties": {
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "section": { "type": ["integer", "null"], "minimum": 0 },
        "offset": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 0 }
      }
    },
    "archive_member": {
      "type": "object",
      "required": ["name", "fingerprint", "offset", "size", "format", "thin", "parse_error"],
      "properties": {
        "name": { "type": "string" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "offset": { "type": ["integer", "null"], "minimum": 0, "description": "Where the member sits in the archive. Null for a thin member, which the archive names rather than carries, so it occupies no position in it." },
        "size": { "type": ["integer", "null"], "minimum": 0, "description": "The member's observed byte length. Null for a thin member, whose bytes this parse never read; not zero, which would be a measured length." },
        "format": { "type": ["string", "null"], "enum": ["wasm", "elf", "macho", "pe-coff", "archive", null] },
        "thin": { "type": "boolean" },
        "parse_error": { "type": ["string", "null"] }
      }
    },
    "symbol": {
      "type": "object",
      "required": ["fingerprint", "name", "exported", "offset", "size", "size_inferred"],
      "properties": {
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "name": { "type": ["string", "null"] },
        "exported": { "type": "boolean" },
        "offset": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 0 },
        "size_inferred": {
          "type": "boolean",
          "description": "Whether the size was derived from neighbouring boundaries rather than declared."
        }
      }
    },
    "source_map": {
      "type": "object",
      "required": ["uri", "status"],
      "properties": {
        "uri": { "type": "string" },
        "status": { "type": "string", "enum": ["resolved", "unavailable"] },
        "local_path": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string" }
      }
    },
    "capabilities": {
      "type": "object",
      "description": "What the parser could establish for this artifact. A false entry means the evidence is absent, never that the answer is zero.",
      "required": [
        "symbols", "call_graph", "source_mapping", "debug_info_unreadable",
        "normalized_duplicates", "independent_data_segments", "relocations", "data_segments"
      ],
      "properties": {
        "symbols": { "type": "boolean" },
        "call_graph": { "type": "boolean" },
        "source_mapping": { "type": "boolean" },
        "debug_info_unreadable": { "type": "boolean" },
        "normalized_duplicates": { "type": "boolean" },
        "independent_data_segments": { "type": "boolean" },
        "relocations": { "type": "boolean" },
        "data_segments": { "type": "boolean" }
      }
    },
    "dead_code": {
      "type": ["object", "null"],
      "description": "Symbols not reached from a parser-established root set, or null when no trustworthy root set exists.",
      "required": ["symbols", "definitive", "assumptions"],
      "properties": {
        "symbols": { "type": "array", "items": { "$ref": "#/$defs/fingerprint_bytes" } },
        "definitive": {
          "type": "boolean",
          "description": "True only when every call endpoint resolved and every symbol carries a distinct content fingerprint. Shared identities or a missing endpoint leave a candidate list and an assumption naming the reason."
        },
        "assumptions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "retained_size": {
      "type": "object",
      "required": ["symbol", "retained_bytes"],
      "properties": {
        "symbol": { "$ref": "#/$defs/fingerprint_bytes" },
        "retained_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "duplicate_summary": {
      "type": "object",
      "required": [
        "exact_groups", "exact_duplicated_bytes",
        "normalized_groups", "normalized_duplicated_bytes"
      ],
      "properties": {
        "exact_groups": { "type": "integer", "minimum": 0 },
        "exact_duplicated_bytes": { "type": "integer", "minimum": 0 },
        "normalized_groups": { "type": "integer", "minimum": 0 },
        "normalized_duplicated_bytes": {
          "type": "integer", "minimum": 0,
          "description": "Excess bytes in groups equal only after normalization, counted apart from the exact total."
        }
      }
    },
    "duplicate_groups": {
      "type": "object",
      "description": "Full equality groups, each equality relation kept separate so a normalized match is never read as a byte-for-byte match.",
      "required": ["exact", "normalized", "data"],
      "properties": {
        "exact": { "type": "array", "items": { "$ref": "#/$defs/duplicate_group" } },
        "normalized": { "type": "array", "items": { "$ref": "#/$defs/duplicate_group" } },
        "data": { "type": "array", "items": { "$ref": "#/$defs/duplicate_group" } }
      }
    },
    "duplicate_group": {
      "type": "object",
      "required": ["fingerprint", "duplicated_bytes", "members"],
      "properties": {
        "fingerprint": { "$ref": "#/$defs/fingerprint_bytes" },
        "duplicated_bytes": {
          "type": "integer", "minimum": 0,
          "description": "Observed excess bytes in this group, not a claimed size saving."
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["symbol", "offset", "size"],
            "properties": {
              "symbol": { "$ref": "#/$defs/fingerprint_bytes" },
              "offset": { "type": "integer", "minimum": 0 },
              "size": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "sizes": {
      "type": "object",
      "required": [
        "observed_bytes", "duplicated_bytes", "duplicated_bytes_normalized",
        "retained_bytes",
        "shared_dependency_bytes", "duplicated_data_bytes",
        "upper_bound_savings_bytes", "estimated_refactor_savings_bytes",
        "verified_savings_bytes", "clone_confidence", "savings_confidence", "assumptions"
      ],
      "properties": {
        "observed_bytes": { "type": "integer", "minimum": 0 },
        "duplicated_bytes": {
          "type": "integer", "minimum": 0,
          "description": "Excess bytes in byte-identical duplicate code groups. Duplication reached only through normalization is counted separately and is not added here."
        },
        "duplicated_bytes_normalized": {
          "type": ["integer", "null"], "minimum": 0,
          "description": "Excess bytes in code groups equal only after normalization, or null when no normalizer exists for the architecture. Weaker evidence than duplicated_bytes, so it feeds no savings value."
        },
        "retained_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "shared_dependency_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "duplicated_data_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "upper_bound_savings_bytes": {
          "type": ["integer", "null"], "minimum": 0,
          "description": "Theoretical maximum from directly observed exact duplication of code only; excludes duplicated_data_bytes. An upper bound, not a guaranteed reduction."
        },
        "estimated_refactor_savings_bytes": { "type": ["integer", "null"] },
        "verified_savings_bytes": { "type": ["integer", "null"] },
        "clone_confidence": { "type": "string" },
        "savings_confidence": { "type": "string" },
        "assumptions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "containment": {
      "type": ["object", "null"],
      "required": ["max_input_bytes", "worker_timeout_seconds", "worker_memory_limit_bytes", "max_debug_derived_items"],
      "properties": {
        "max_input_bytes": { "type": "integer", "minimum": 0 },
        "worker_timeout_seconds": { "type": "integer", "minimum": 1 },
        "worker_memory_limit_bytes": { "type": "integer", "minimum": 1 },
        "max_debug_derived_items": { "type": "integer", "minimum": 0, "description": "How many structures the parse would build out of debug information before stopping and reporting that information as not fully read. Stated because the input ceiling alone does not imply it: debug metadata describes address ranges and line rows far more compactly than the structures a reader builds from them." }
      }
    },
    "correlation": {
      "type": ["object", "null"],
      "properties": {
        "source_run": { "type": "integer" },
        "mappings": { "type": "integer", "minimum": 0 },
        "artifact_symbols": { "type": "integer", "minimum": 0 },
        "mapped_symbols": { "type": "integer", "minimum": 0 },
        "mapping_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "mapped_symbol_bytes": { "type": "integer", "minimum": 0 },
        "mapped_symbol_bytes_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "unmapped_symbols": { "type": "integer", "minimum": 0 },
        "unmapped_symbol_bytes": { "type": "integer", "minimum": 0 },
        "unmapped_symbol_reasons": {
          "type": "object",
          "description": "Count per reason, over the same symbol-table population as the mapped and unmapped counts.",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "source_entities": { "type": "integer", "minimum": 0 },
        "unmapped_sources": { "type": "integer", "minimum": 0 },
        "unmapped_source_reasons": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "clone_group_attributions": {
          "type": "array",
          "description": "Bytes attributed to clone groups. Observed and line-proportional bytes are reported in separate fields and are never added together.",
          "items": {
            "type": "object",
            "required": [
              "clone_group_fingerprint", "source_build_variant_fingerprint", "members",
              "attributed_noncanonical_members", "duplicated_bytes",
              "estimated_duplicated_bytes", "containing_symbols",
              "containing_symbol_bytes", "clone_confidence"
            ],
            "properties": {
              "clone_group_fingerprint": { "$ref": "#/$defs/fingerprint" },
              "source_build_variant_fingerprint": { "$ref": "#/$defs/fingerprint" },
              "members": { "type": "integer", "minimum": 0 },
              "attributed_noncanonical_members": { "type": "integer", "minimum": 0 },
              "duplicated_bytes": {
                "type": ["integer", "null"], "minimum": 0,
                "description": "Observed bytes, present only when every noncanonical member covers its whole artifact symbol."
              },
              "estimated_duplicated_bytes": {
                "type": ["integer", "null"], "minimum": 0,
                "description": "Total attributed bytes when at least one member's share was divided across its symbol's source lines. That division is a construction, so this value is an estimate and is never reported as observed."
              },
              "containing_symbols": {
                "type": "integer", "minimum": 0,
                "description": "Distinct artifact symbols the group's noncanonical members were placed in. A format carrying symbol names but no line frames settles which symbol holds a member and nothing finer, so this is what such a format can state."
              },
              "containing_symbol_bytes": {
                "type": ["integer", "null"], "minimum": 0,
                "description": "Observed size of those symbols, counted once per symbol. The symbols hold the members and are usually larger than them, so this bounds what the group occupies rather than measuring it, and is never a duplicated-byte total."
              },
              "clone_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "estimated_refactor_savings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "clone_group_fingerprint", "source_build_variant_fingerprint",
              "artifact_build_variant_fingerprint", "estimated_refactor_savings_bytes",
              "duplicated_bytes_basis"
            ],
            "properties": {
              "clone_group_fingerprint": { "$ref": "#/$defs/fingerprint" },
              "source_build_variant_fingerprint": { "$ref": "#/$defs/fingerprint" },
              "artifact_build_variant_fingerprint": { "$ref": "#/$defs/fingerprint" },
              "duplicated_bytes": {
                "type": "integer", "minimum": 0,
                "description": "Attributed bytes this estimate was derived from. duplicated_bytes_basis states which evidence established them."
              },
              "duplicated_bytes_basis": {
                "type": "string",
                "description": "Evidence class of duplicated_bytes: observed means every contributing member covered its whole artifact symbol, line_proportional means at least one member's share was divided across its symbol's source lines and the total is therefore an estimate.",
                "enum": ["observed", "line_proportional"]
              },
              "estimated_refactor_savings_bytes": { "type": "integer" },
              "mapping_confidence": {
                "type": "string",
                "description": "Weakest grade among the mappings that contributed bytes to this row.",
                "enum": ["high", "medium", "low", "unavailable"]
              },
              "clone_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "model_confidence": { "type": "string", "enum": ["high", "medium", "low", "unavailable"] },
              "savings_confidence": { "type": "string", "enum": ["high", "medium", "low", "unavailable"] },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["kind"],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "shared_implementation_retains_copies",
                        "call_overhead_per_replaced_member",
                        "inlining_outcome_unknown",
                        "linker_icf_outcome_unknown",
                        "attribution_is_line_proportional"
                      ]
                    },
                    "copies": { "type": "integer", "minimum": 0 },
                    "bytes": { "type": "integer" }
                  }
                }
              },
              "model_schema_version": { "type": "string" }
            }
          }
        },
        "multiply_emitted_units": {
          "type": "array",
          "description": "Source units the artifact emitted as more than one body. A source copy and an emitted body are different populations: a generic written once is emitted once per instantiation, so consolidating the single copy removes none of the bodies. Every value here is an observation about the artifact as it stands and none of them is a saving.",
          "items": {
            "type": "object",
            "required": [
              "source_fingerprint", "source_build_variant_fingerprint", "name",
              "emitted_bodies", "observed_symbol_bytes", "mapping_confidence"
            ],
            "properties": {
              "source_fingerprint": { "$ref": "#/$defs/fingerprint" },
              "source_build_variant_fingerprint": { "$ref": "#/$defs/fingerprint" },
              "name": {
                "type": ["string", "null"],
                "description": "Symbol spelling the correspondence matched on, kept as display evidence."
              },
              "emitted_bodies": {
                "type": "integer", "minimum": 2,
                "description": "Distinct artifact symbols this one source unit was mapped to. A unit emitted once says nothing reading the source did not already say, so only units above one appear."
              },
              "observed_symbol_bytes": {
                "type": "integer", "minimum": 0,
                "description": "Observed sizes of those symbols, summed. This is what the artifact spends on the unit today, not what removing anything would return."
              },
              "mapping_confidence": {
                "type": "string",
                "description": "Weakest grade among the mappings counted, so a name-only correspondence is distinguishable from a debug-located one.",
                "enum": ["high", "medium", "low", "unavailable"]
              }
            }
          }
        },
        "generic_origins": {
          "type": "array",
          "description": "Generic definitions whose instantiations were attributed to artifact symbols. Reported under the correlation because attributing a symbol to the definition it came from needs a correlated source run.",
          "items": {
            "type": "object",
            "properties": {
              "definition": { "type": "string" },
              "origin_fingerprint": { "$ref": "#/$defs/fingerprint" },
              "origin_build_variant_fingerprint": { "$ref": "#/$defs/fingerprint" },
              "instantiations": { "type": "integer", "minimum": 0 },
              "translation_units": { "type": "integer", "minimum": 0 },
              "artifact_symbols": { "type": "integer", "minimum": 0 },
              "observed_symbol_bytes": { "type": "integer", "minimum": 0 },
              "normalized_instruction_duplicated_bytes": {
                "type": "integer", "minimum": 0,
                "description": "Excess observed bytes in equal normalized instruction groups for this origin, which is a duplicate observation and not a claimed saving."
              },
              "retained_size_sum": {
                "type": ["integer", "null"], "minimum": 0,
                "description": "Sum of per-symbol retained sizes when the call graph supports them. Retained regions overlap, so this is not a removable total."
              },
              "specializations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "instantiation_key": { "type": "string" },
                    "type_arguments": { "type": "array", "items": { "type": "string" } },
                    "artifact_symbols": { "type": "integer", "minimum": 0 },
                    "translation_units": { "type": "integer", "minimum": 0 },
                    "observed_symbol_bytes": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          }
        },
        "macro_origins": {
          "type": "array",
          "description": "Macro definitions whose expansions were attributed to artifact symbols, on the same correlated evidence as generic_origins.",
          "items": {
            "type": "object",
            "properties": {
              "origin_fingerprint": { "$ref": "#/$defs/fingerprint" },
              "origin_build_variant_fingerprint": { "$ref": "#/$defs/fingerprint" },
              "definition_paths": { "type": "array", "items": { "type": "string" } },
              "artifact_symbols": { "type": "integer", "minimum": 0 },
              "observed_symbol_bytes": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
