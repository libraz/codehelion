{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/libraz/codehelion/blob/main/crates/codehelion-cli/schema/finding-detail-v1.schema.json",
  "title": "codehelion finding detail v1",
  "description": "Machine-readable response from codehelion explain. response_kind distinguishes the stable-id domain that was resolved.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version", "response_kind", "database", "scan_run", "analysis_mode",
        "build_variant", "group"
      ],
      "properties": {
        "schema_version": { "const": "finding-detail-v1" },
        "response_kind": { "const": "clone_group" },
        "database": { "type": "string" },
        "scan_run": { "type": "integer" },
        "analysis_mode": { "enum": ["fast", "structural", "semantic"] },
        "build_variant": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "latest_scan_run": { "type": ["integer", "null"] },
        "present_in_latest_run": { "type": ["boolean", "null"] },
        "group": {
          "$ref": "https://github.com/libraz/codehelion/blob/main/crates/codehelion-cli/schema/scan-report-v2.schema.json#/$defs/group"
        }
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "response_kind", "finding_id", "group", "scan_run"],
      "properties": {
        "schema_version": { "const": "finding-detail-v1" },
        "response_kind": { "const": "occurrence" },
        "finding_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "group": { "$ref": "#/$defs/group_reference" },
        "scan_run": { "type": "integer" }
      }
    },
    {
      "type": "object",
      "required": [
        "schema_version", "response_kind", "group_id", "comparison_id",
        "policy_version", "root_path", "origin_variants", "rule_id",
        "rule_version", "semantic_confidence", "correspondence_ids", "members"
      ],
      "properties": {
        "schema_version": { "const": "finding-detail-v1" },
        "response_kind": { "const": "cross_language_group" },
        "group_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "comparison_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "policy_version": { "type": "string" },
        "root_path": { "type": "string" },
        "origin_variants": { "type": "array", "items": { "type": "string" } },
        "rule_id": { "type": "string" },
        "rule_version": { "type": "integer", "minimum": 0 },
        "semantic_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "correspondence_ids": { "type": "array", "items": { "type": "string" } },
        "members": { "type": "array" }
      }
    },
    {
      "type": "object",
      "required": [
        "schema_version", "response_kind", "scan_run", "group_fingerprint", "sibling"
      ],
      "properties": {
        "schema_version": { "const": "finding-detail-v1" },
        "response_kind": { "const": "sibling" },
        "scan_run": { "type": "integer" },
        "group_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "sibling": { "type": "object" }
      }
    },
    {
      "type": "object",
      "required": [
        "schema_version", "response_kind", "group_id", "comparison_id",
        "policy_version", "root_path", "origin_variants", "clone_type", "members"
      ],
      "properties": {
        "schema_version": { "const": "finding-detail-v1" },
        "response_kind": { "const": "cross_variant_group" },
        "group_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "comparison_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "policy_version": { "type": "string" },
        "root_path": { "type": "string" },
        "origin_variants": { "type": "array", "items": { "type": "string" } },
        "clone_type": { "const": "type-1" },
        "members": { "type": "array" }
      }
    }
  ],
  "$defs": {
    "group_reference": {
      "type": "object",
      "required": [
        "fingerprint", "clone_type", "scope", "confidence", "entropy_bits",
        "members", "test_code", "split_pair"
      ],
      "properties": {
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "clone_type": { "type": "string" },
        "scope": { "type": "string" },
        "confidence": { "type": "number" },
        "entropy_bits": { "type": "number" },
        "members": { "type": "integer", "minimum": 2 },
        "test_code": { "type": "boolean" },
        "split_pair": { "type": "boolean" }
      }
    }
  }
}
